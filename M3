/**
 * Quantity: a whole number from 1 up to the stock available.
 * @param {string|number} value - what the user typed
 * @param {number} maxStock - available quantity of the product
 */
export function validateQuantity(value, maxStock) {
  const text = String(value).trim();
  if (!text) return "Quantity is required.";
  if (!/^\d+$/.test(text) || Number(text) < 1) return "Enter a whole number of 1 or more.";
  if (Number(text) > maxStock) return `Only ${maxStock} in stock.`;
  return "";
}






