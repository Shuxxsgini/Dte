import { useEffect, useState } from "react";

import SearchBar from "../components/products/SearchBar.jsx";
import ProductCard from "../components/products/ProductCard.jsx";
import AlertMessage from "../components/common/AlertMessage.jsx";
import { getProducts } from "../services/productService.js";

// Milestone 2: Product listing with search by name or category
function ProductListPage() {
  const [products, setProducts] = useState([]);     // all products from the backend
  const [searchText, setSearchText] = useState(""); // what the user types
  const [error, setError] = useState("");

  // Load all products once, when the page opens
  useEffect(() => {
    getProducts()
      .then((data) => setProducts(data))
      .catch((err) => setError(err.message));
  }, []);

  // Filter as the user types: keep products whose name OR category contains the text.
  // (An empty search matches everything, so all products show.)
  const search = searchText.trim().toLowerCase();
  const filteredProducts = products.filter(
    (product) =>
      product.product_name.toLowerCase().includes(search) ||
      product.category.category_name.toLowerCase().includes(search)
  );

  return (
    <>
      <h1 className="h3 mb-3">Products</h1>

      <SearchBar value={searchText} onChange={setSearchText} />
      <AlertMessage type="danger" message={error} />

      {filteredProducts.length === 0 ? (
        !error && <p>No products found.</p>
      ) : (
        // Grid: 1 card per row on phones, 2 on tablets, 3 on laptops
        <div className="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
          {filteredProducts.map((product) => (
            <div className="col" key={product.product_id}>
              <ProductCard product={product} />
            </div>
          ))}
        </div>
      )}
    </>
  );
}

export default ProductListPage;


