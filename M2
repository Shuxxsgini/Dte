import { useEffect, useState } from "react";
import { Link, useParams } from "react-router-dom";

import AlertMessage from "../components/common/AlertMessage.jsx";
import { getProductById } from "../services/productService.js";

// Milestone 2: Detailed information about one product
function ProductDetailsPage() {
  const { productId } = useParams(); // the ":productId" part of the URL
  const [product, setProduct] = useState(null);
  const [error, setError] = useState("");

  // Load this product when the page opens
  useEffect(() => {
    getProductById(productId)
      .then((data) => setProduct(data))
      .catch((err) => setError(err.message)); // e.g. 404 "Product not found."
  }, [productId]);

  if (error) return <AlertMessage type="danger" message={error} />;
  if (!product) return null; // the data hasn't arrived yet

  const inStock = product.available_quantity > 0;

  return (
    <>
      <Link to="/products">Back to products</Link>

      <h1 className="h3 mt-3">{product.product_name}</h1>
      <p className="text-secondary">{product.category.category_name}</p>
      <p className="fs-4 fw-bold">₹{product.price}</p>
      {/* No blank fields: show a fallback if there's no description */}
      <p>{product.description || "No description available."}</p>
      <p>{inStock ? `In stock: ${product.available_quantity}` : "Out of Stock"}</p>

      {/* Connected to the cart in Milestone 3 */}
      <button type="button" className="btn btn-dark" disabled={!inStock}>
        {inStock ? "Add to Cart" : "Out of Stock"}
      </button>
    </>
  );
}

export default ProductDetailsPage;


