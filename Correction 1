import { useCallback, useEffect, useState } from "react";
import { Link, useNavigate } from "react-router-dom";

import CartItemRow from "../components/cart/CartItemRow.jsx";
import AlertMessage from "../components/common/AlertMessage.jsx";
import { getCartItems, getCartSummary, removeCartItem, updateCartItem } from "../services/cartService.js";
import { getProducts } from "../services/productService.js";

// Cart: view, update quantity, remove, total, checkout
function CartPage() {
  const navigate = useNavigate();

  const [items, setItems] = useState([]);
  const [summary, setSummary] = useState(null); // null until the backend answers
  const [stockById, setStockById] = useState({}); // { product_id: available_quantity }
  const [message, setMessage] = useState("");
  const [error, setError] = useState("");

  // Load the cart, the totals, and the stock together
  const loadCart = useCallback(async () => {
    try {
      const [cartItems, cartSummary, products] = await Promise.all([
        getCartItems(),
        getCartSummary(),
        getProducts(),
      ]);

      const stock = {};
      products.forEach((product) => {
        stock[product.product_id] = product.available_quantity;
      });

      setItems(cartItems);
      setSummary(cartSummary);
      setStockById(stock);
    } catch (err) {
      setError(err.message);
    }
  }, []);

  useEffect(() => {
    loadCart();
  }, [loadCart]);

  // After each change we reload, so the total updates automatically
  const handleUpdate = async (cartItemId, quantity) => {
    setError("");
    try {
      await updateCartItem(cartItemId, quantity);
      await loadCart();
      setMessage("Quantity updated.");
    } catch (err) {
      setError(err.message);
    }
  };

  const handleRemove = async (cartItemId) => {
    setError("");
    try {
      await removeCartItem(cartItemId);
      await loadCart();
      setMessage("Item removed from your cart.");
    } catch (err) {
      setError(err.message);
    }
  };

  // No data yet: show only the error (if any). This prevents "Cannot read properties of null".
  if (!summary) return <AlertMessage type="danger" message={error} />;

  return (
    <>
      <h1 className="h3 mb-3">Your Cart</h1>
      <AlertMessage type="success" message={message} />
      <AlertMessage type="danger" message={error} />

      {items.length === 0 ? (
        <p>
          Your cart is empty. <Link to="/products">Browse products</Link>
        </p>
      ) : (
        <div className="table-responsive">
          <table className="table align-middle">
            <thead>
              <tr>
                <th>Product</th>
                <th>Price</th>
                <th>Qty</th>
                <th>Subtotal</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              {items.map((item) => (
                <CartItemRow
                  key={item.cart_item_id}
                  item={item}
                  stock={stockById[item.product.product_id] ?? 0}
                  onUpdate={handleUpdate}
                  onRemove={handleRemove}
                />
              ))}
            </tbody>
          </table>
        </div>
      )}

      {/* Cart summary from /api/cart/summary */}
      <div className="text-end">
        <p className="mb-1">Items: {summary.total_quantity}</p>
        <p className="fs-5 fw-bold">Total: ₹{summary.total_amount}</p>
        <button
          type="button"
          className="btn btn-dark"
          disabled={items.length === 0}
          onClick={() => navigate("/checkout")}
        >
          Checkout
        </button>
      </div>
    </>
  );
}

export default CartPage;




