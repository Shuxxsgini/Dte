import { useEffect, useState } from "react";
import { Link } from "react-router-dom";

import AlertMessage from "../components/common/AlertMessage.jsx";
import { getMyOrders } from "../services/orderService.js";

// Milestone 4: My orders (the backend returns only the logged-in user's orders)
function OrderHistoryPage() {
  const [orders, setOrders] = useState(null); // null = not loaded yet
  const [error, setError] = useState("");

  useEffect(() => {
    getMyOrders()
      // Newest first ([...data] copies the list before sorting)
      .then((data) => setOrders([...data].sort((a, b) => b.order_id - a.order_id)))
      .catch((err) => setError(err.message));
  }, []);

  if (error) return <AlertMessage type="danger" message={error} />;
  if (!orders) return null;

  return (
    <>
      <h1 className="h3 mb-3">Order History</h1>

      {orders.length === 0 ? (
        <p>No orders found.</p>
      ) : (
        <div className="table-responsive">
          <table className="table align-middle">
            <thead>
              <tr>
                <th>Order</th>
                <th>Date</th>
                <th>Total</th>
                <th>Status</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              {orders.map((order) => (
                <tr key={order.order_id}>
                  <td>#{order.order_id}</td>
                  <td>{new Date(order.order_date).toLocaleDateString("en-IN")}</td>
                  <td>₹{order.total_amount}</td>
                  <td className="text-capitalize">{order.status}</td>
                  <td className="text-end">
                    <Link to={`/orders/${order.order_id}`} className="btn btn-outline-dark btn-sm">
                      View details
                    </Link>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </>
  );
}

export default OrderHistoryPage;






