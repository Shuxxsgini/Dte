import PropTypes from "prop-types";

// Products of one order: name, quantity, price, subtotal, and the total
function OrderItemsTable({ details, total }) {
  return (
    <div className="table-responsive">
      <table className="table mb-0">
        <thead>
          <tr>
            <th>Product</th>
            <th>Qty</th>
            <th>Price</th>
            <th className="text-end">Subtotal</th>
          </tr>
        </thead>
        <tbody>
          {details.map((line) => (
            <tr key={line.order_detail_id}>
              <td>{line.product.product_name}</td>
              <td>{line.quantity}</td>
              {/* price = the price paid on the order day */}
              <td>₹{line.price}</td>
              <td className="text-end">₹{(Number(line.price) * line.quantity).toFixed(2)}</td>
            </tr>
          ))}
        </tbody>
        <tfoot>
          <tr>
            <th colSpan={3} className="text-end">Total</th>
            <th className="text-end">₹{total}</th>
          </tr>
        </tfoot>
      </table>
    </div>
  );
}

OrderItemsTable.propTypes = {
  details: PropTypes.arrayOf(
    PropTypes.shape({
      order_detail_id: PropTypes.number.isRequired,
      quantity: PropTypes.number.isRequired,
      price: PropTypes.oneOfType([PropTypes.string, PropTypes.number]).isRequired,
      product: PropTypes.shape({ product_name: PropTypes.string.isRequired }).isRequired,
    })
  ).isRequired,
  total: PropTypes.oneOfType([PropTypes.string, PropTypes.number]).isRequired,
};

export default OrderItemsTable;



