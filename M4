import { useEffect, useState } from "react";
import { Link, useParams } from "react-router-dom";

import AlertMessage from "../components/common/AlertMessage.jsx";
import OrderItemsTable from "../components/orders/OrderItemsTable.jsx";
import { cancelOrder, getOrderDetails } from "../services/orderService.js";

// Milestone 4: One order with all products, quantities, and prices (+ cancel from the backend)
function OrderDetailsPage() {
  const { orderId } = useParams();
  const [order, setOrder] = useState(null);
  const [error, setError] = useState("");
  const [message, setMessage] = useState("");

  useEffect(() => {
    getOrderDetails(orderId)
      .then((data) => setOrder(data))
      // 404 also means "not your order" (the backend hides other people's orders)
      .catch((err) => setError(err.message));
  }, [orderId]);

  const handleCancel = async () => {
    if (!window.confirm(`Cancel order #${order.order_id}?`)) return;
    setError("");
    try {
      const updated = await cancelOrder(order.order_id);
      setOrder(updated); // shows the new "cancelled" status
      setMessage("Your order was cancelled.");
    } catch (err) {
      setError(err.message);
    }
  };

  if (!order) return <AlertMessage type="danger" message={error} />;

  return (
    <>
      <Link to="/orders">Back to my orders</Link>

      <div className="mt-3">
        <AlertMessage type="success" message={message} />
        <AlertMessage type="danger" message={error} />
      </div>

      <h1 className="h3">Order #{order.order_id}</h1>
      <p className="text-secondary">
        Date: {new Date(order.order_date).toLocaleDateString("en-IN")} | Payment:{" "}
        {order.payment_method.replaceAll("_", " ")} | Status: <span className="text-capitalize">{order.status}</span>
      </p>

      <OrderItemsTable details={order.details} total={order.total_amount} />

      {order.status !== "cancelled" && (
        <button type="button" className="btn btn-outline-danger mt-3" onClick={handleCancel}>
          Cancel order
        </button>
      )}
    </>
  );
}

export default OrderDetailsPage;



