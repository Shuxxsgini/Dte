// Calls for orders. All need the token.
import { apiRequest } from "./apiClient.js";

/** The logged-in user's own orders */
export const getMyOrders = () => apiRequest("/api/orders/me", { auth: true });

/** One of my orders, with all its products (404 if it isn't mine) */
export const getOrderDetails = (orderId) => apiRequest(`/api/orders/details/${orderId}`, { auth: true });

/** Cancel one of my orders (the backend puts the stock back) */
export const cancelOrder = (orderId) => apiRequest(`/api/orders/${orderId}/cancel`, { method: "POST", auth: true });

/** Every customer's orders: admin and support only (403 for customers) */
export const getAllOrders = () => apiRequest("/api/admin/orders", { auth: true });





