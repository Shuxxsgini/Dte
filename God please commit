// All order calls to the backend. Every one needs the login token (auth: true).
import { apiRequest } from "./apiClient.js"; // our single helper that talks to FastAPI

// IMPORTANT: a URL with ${...} MUST use backticks ` ` (key under Esc), NOT quotes " ".
// Backticks fill in the value: `/details/${orderId}` → "/details/6"

/** Place an order from the cart. paymentMethod = "CREDIT_CARD" or "CASH_ON_DELIVERY" */
export const placeOrder = (paymentMethod) =>
  apiRequest("/api/orders/checkout", {
    method: "POST", // POST = create something new
    body: { payment_method: paymentMethod }, // matches the backend's CheckOutRequest
    auth: true, // adds "Authorization: Bearer <token>"
  });

/** My own orders only (the backend reads "who am I" from the token) */
export const getMyOrders = () => apiRequest("/api/orders/me", { auth: true });

/** One of my orders with all its products (404 if it isn't mine) */
export const getOrderDetails = (orderId) =>
  apiRequest(`/api/orders/details/${orderId}`, { auth: true }); // backticks!

/** Cancel one of my orders (the backend sets status "cancelled" and returns stock) */
export const cancelOrder = (orderId) =>
  apiRequest(`/api/orders/${orderId}/cancel`, { method: "POST", auth: true }); // backticks!

/** Every customer's orders: admin & support only (a customer gets 403) */
export const getAllOrders = () => apiRequest("/api/admin/orders", { auth: true });




