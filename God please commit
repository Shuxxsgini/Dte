import { NavLink } from "react-router-dom"; // NavLink = Link that highlights the current page

import { useAuth } from "../../context/AuthContext.jsx";

// All menu links. roles = only these roles see the link
const MENU_LINKS = [
  { path: "/", label: "Home" },
  { path: "/products", label: "Products" },
  { path: "/cart", label: "Cart" },
  { path: "/orders", label: "My Orders" },
  { path: "/admin/orders", label: "All Orders", roles: ["admin", "support"] },
];

function Menu() {
  const { user } = useAuth(); // null when logged out

  // Keep links with no roles, or whose roles include the user's role
  const visibleLinks = MENU_LINKS.filter((link) => !link.roles || (user && link.roles.includes(user.role)));

  return (
    <nav aria-label="Main menu">
      <ul className="nav">
        {visibleLinks.map((link) => (
          <li className="nav-item" key={link.path}>
            {/* end on "/" so Home isn't highlighted on every page */}
            <NavLink to={link.path} end={link.path === "/"} className="nav-link text-dark">
              {link.label}
            </NavLink>
          </li>
        ))}
      </ul>
    </nav>
  );
}

export default Menu;




