import { useEffect, useState } from "react";
import { Link, useLocation, useParams } from "react-router-dom";

import AlertMessage from "../components/common/AlertMessage.jsx";
import OrderItemsTable from "../components/orders/OrderItemsTable.jsx";
import { cancelOrder, getOrderDetails } from "../services/orderService.js";

// One order: products, qty, prices, total, status + Cancel
function OrderDetailsPage() {
  const { orderId } = useParams(); // reads ":orderId" from the URL. Must match App.jsx exactly!
  const location = useLocation(); // gives the message sent by the Checkout page

  const [order, setOrder] = useState(null);
  const [error, setError] = useState("");
  // ?. = "if it exists". Start with Checkout's success message, or "" if none
  const [message, setMessage] = useState(location.state?.success ?? "");

  // [orderId] = run again whenever the order number in the URL changes
  useEffect(() => {
    getOrderDetails(orderId)
      .then((data) => setOrder(data))
      .catch((err) => setError(err.message)); // 404 = not found or not yours
  }, [orderId]);

  const handleCancel = async () => {
    // confirm() = browser's OK/Cancel box. Stop if the user clicks Cancel
    if (!window.confirm(`Cancel order #${order.order_id}?`)) return;
    setError("");
    try {
      const updated = await cancelOrder(order.order_id); // backend returns the updated order
      setOrder(updated); // page redraws with status "cancelled"
      setMessage("Your order was cancelled.");
    } catch (err) {
      setError(err.message); // e.g. "Order is already cancelled."
    }
  };

  if (!order) return <AlertMessage type="danger" message={error} />;

  return (
    <>
      <Link to="/orders">Back to my orders</Link>

      <div className="mt-3">
        <AlertMessage type="success" message={message} />
        <AlertMessage type="danger" message={error} />
      </div>

      <h1 className="h3">Order #{order.order_id}</h1>
      <p className="text-secondary">
        {/* replaceAll("_", " ") turns CASH_ON_DELIVERY into CASH ON DELIVERY */}
        Date: {new Date(order.order_date).toLocaleDateString("en-IN")} | Payment:{" "}
        {order.payment_method.replaceAll("_", " ")} | Status:{" "}
        <span className={`badge text-capitalize ${order.status === "cancelled" ? "text-bg-secondary" : "text-bg-success"}`}>
          {order.status}
        </span>
      </p>

      <OrderItemsTable details={order.details} total={order.total_amount} />

      {/* !== = "is not". Only orders that aren't cancelled yet show the button */}
      {order.status !== "cancelled" && (
        <button type="button" className="btn btn-outline-danger mt-3" onClick={handleCancel}>
          Cancel order
        </button>
      )}
    </>
  );
}

export default OrderDetailsPage;




