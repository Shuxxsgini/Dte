import { useEffect, useState } from "react"; // useState = memory, useEffect = run code after drawing
import { useNavigate } from "react-router-dom"; // useNavigate = go to another page from code

import SearchBar from "../components/products/SearchBar.jsx";
import ProductCard from "../components/products/ProductCard.jsx";
import AlertMessage from "../components/common/AlertMessage.jsx";
import { getProducts } from "../services/productService.js";
import { addToCart } from "../services/cartService.js";
import { useAuth } from "../context/AuthContext.jsx";

// Milestones 2 + 3: product list, search by name/category, Add to Cart
function ProductListPage() {
  const navigate = useNavigate();
  const { isLoggedIn } = useAuth(); // true if someone is logged in

  const [products, setProducts] = useState([]); // [] = empty list (NOT null) so .filter never crashes
  const [searchText, setSearchText] = useState("");
  const [error, setError] = useState("");
  const [message, setMessage] = useState("");
  const [addedCounts, setAddedCounts] = useState({}); // { product_id: times added }, e.g. { 4: 2 }

  // [] at the end = run once, when the page opens
  useEffect(() => {
    getProducts()
      .then((data) => setProducts(Array.isArray(data) ? data : [])) // accept only a real list
      .catch((err) => setError(err.message));
  }, []);

  // Search: keep products whose name OR category contains the typed text
  const search = searchText.trim().toLowerCase(); // trim = remove spaces at the ends
  const filteredProducts = products.filter(
    (product) =>
      product.product_name.toLowerCase().includes(search) ||
      product.category.category_name.toLowerCase().includes(search) // || = OR
  );

  // async = this function waits (await) for the backend
  const handleAddToCart = async (product) => {
    if (!isLoggedIn) {
      // ! = NOT. Cart needs login → go to Login, then come back to /products
      navigate("/login", { state: { from: "/products", message: "Please log in to add items to your cart." } });
      return; // stop here
    }

    setError("");
    try {
      await addToCart(product.product_id, 1); // POST /api/cart/add
      // Count +1 for this product. ?? 0 = "use 0 if there's no number yet"
      setAddedCounts((prev) => ({ ...prev, [product.product_id]: (prev[product.product_id] ?? 0) + 1 }));
      setMessage(`${product.product_name} was added to your cart.`);
    } catch (err) {
      setMessage("");
      setError(err.message); // e.g. "Only 5 'Apron' in stock."
    }
  };

  return (
    <>
      <h1 className="h3 mb-3">Products</h1>

      <SearchBar value={searchText} onChange={setSearchText} />
      <AlertMessage type="success" message={message} />
      <AlertMessage type="danger" message={error} />

      {filteredProducts.length === 0 ? (
        !error && <p>No products found.</p>
      ) : (
        // Grid: 1 card per row on phones, 2 on tablets, 3 on laptops
        <div className="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
          {/* .map = turn each product into a card. key = unique id React needs */}
          {filteredProducts.map((product) => (
            <div className="col" key={product.product_id}>
              <ProductCard
                product={product}
                onAddToCart={handleAddToCart}
                addedCount={addedCounts[product.product_id] ?? 0}
              />
            </div>
          ))}
        </div>
      )}
    </>
  );
}

export default ProductListPage;




