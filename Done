src/utils/validators.js

// All form validation rules in one place.
// Each function returns an error message, or "" (empty) when the value is valid.
// Rules come from the Week 4 PDF, plus the backend's limits
// (name max 25, email max 50, password max 25, mobile = 10 digits).

const NAME_PATTERN = /^[A-Za-z ]+$/;               // letters and spaces only
const EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@]+$/; // something@something.something
const MOBILE_PATTERN = /^\d{10}$/;                 // exactly 10 digits

/** Name: required, 6–25 characters, letters (and spaces between words) only */
export function validateName(name) {
  const value = name.trim();
  if (!value) return "Name is required.";
  if (!NAME_PATTERN.test(value)) return "Name can contain letters and spaces only.";
  if (value.length < 6) return "Name must be at least 6 characters.";
  if (value.length > 25) return "Name must be 25 characters or fewer.";
  return "";
}

/** Email: required, valid format, at most 50 characters */
export function validateEmail(email) {
  const value = email.trim();
  if (!value) return "Email is required.";
  if (!EMAIL_PATTERN.test(value)) return "Enter a valid email, like name@example.com.";
  if (value.length > 50) return "Email must be 50 characters or fewer.";
  return "";
}

/** Mobile: required, exactly 10 digits (the backend needs it) */
export function validateMobile(mobile) {
  const value = mobile.trim();
  if (!value) return "Mobile number is required.";
  if (!MOBILE_PATTERN.test(value)) return "Mobile number must be exactly 10 digits.";
  return "";
}

/** Password: 8–25 characters with an uppercase, a lowercase, a number, and a special character */
export function validatePassword(password) {
  if (!password) return "Password is required.";
  if (password.length < 8) return "Password must be at least 8 characters.";
  if (password.length > 25) return "Password must be 25 characters or fewer.";
  if (!/[A-Z]/.test(password)) return "Add at least one uppercase letter.";
  if (!/[a-z]/.test(password)) return "Add at least one lowercase letter.";
  if (!/[0-9]/.test(password)) return "Add at least one number.";
  if (!/[^A-Za-z0-9]/.test(password)) return "Add at least one special character, like @ or #.";
  return "";
}

/** Any required field (used for the login password) */
export function validateRequired(value, fieldLabel) {
  return value.trim() ? "" : `${fieldLabel} is required.`;
}

/** All register fields at once → { name, email, mobile, password } error messages */
export const validateRegisterForm = (values) => ({
  name: validateName(values.name),
  email: validateEmail(values.email),
  mobile: validateMobile(values.mobile),
  password: validatePassword(values.password),
});

/** All login fields at once → { email, password } error messages */
export const validateLoginForm = (values) => ({
  email: validateEmail(values.email),
  password: validateRequired(values.password, "Password"),
});




src/hooks/useForm.js

import { useState } from "react";

/**
 * A small reusable hook for forms (used by Register and Login).
 * It keeps the field values, works out the errors, and remembers which
 * fields the user has "touched", so we don't show errors before they type.
 *
 * @param {Record<string, string>} initialValues - e.g. { email: "", password: "" }
 * @param {(values: Record<string, string>) => Record<string, string>} validate
 */
export function useForm(initialValues, validate) {
  const [values, setValues] = useState(initialValues);
  const [touched, setTouched] = useState({});

  // Errors are recalculated on every render, so they're always up to date
  const errors = validate(values);
  const isValid = Object.values(errors).every((message) => message === "");

  // Runs on every key press: copy the old values and change just this field
  const handleChange = (event) => {
    const { name, value } = event.target;
    setValues((previous) => ({ ...previous, [name]: value }));
  };

  // Runs when the user leaves a field: from now on, show its error
  const handleBlur = (event) => {
    const { name } = event.target;
    setTouched((previous) => ({ ...previous, [name]: true }));
  };

  // Mark every field as touched (used on submit, so all errors show)
  const touchAll = () => {
    const allTouched = {};
    Object.keys(initialValues).forEach((name) => {
      allTouched[name] = true;
    });
    setTouched(allTouched);
  };

  // Reset button: every field back to blank, no errors showing
  const reset = () => {
    setValues(initialValues);
    setTouched({});
  };

  // The error to show under a field (only after it's been touched)
  const errorFor = (name) => (touched[name] ? errors[name] : "");

  return { values, isValid, handleChange, handleBlur, touchAll, reset, errorFor };
}



